#!/bin/zsh

# get qr code for wifi

# might not work yet
if [[ "$#" -lt 1 ]]; then
	#arg="$(iw dev wlp0s20f3 link | grep -oP "SSID: \K.*")"
	arg="$(nmcli -g NAME con show --active | head -n1)"
	echo "no argument given, taking current connection ($arg) as arg"
else
	arg="$1"
fi

# needs qrencode and nmcli
if type nmcli >/dev/null 2>&1 && type qrencode >/dev/null 2>&1; then
	echo "creates qr code for connection '$arg'"
else
	echo "Needs qrencode and nmcli"
	return 1
fi

#### actual stuff

local ssid psk
ssid=$(nmcli -s -g 802-11-wireless.ssid con show "$arg")
psk=$(nmcli -s -g 802-11-wireless-security.psk con show "$arg")
# or 802-1x.password (for eduroam), but onespot 802-11-wireless-security.psk
if [ -z "$ssid" -o -z "$psk" ]; then
	echo "Problem with ssid or psk, investigate"
	echo "|ssid||psk|"
	echo "|${ssid}||${psk}|"
	return 1
fi
# echo "${ssid}||$psk"

# create string for qrencode
str="WIFI:S:${ssid};T:WPA2;P:${psk};;"
echo "ssid is '${ssid}' and pw '${psk}'"
# encode it
#
qrdisplay "$str"

return 0
